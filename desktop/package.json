{
  "name": "duel-racer-desktop",
  "productName": "Duel Racer",
  "version": "0.17.3",
  "description": "Duel Racer para computador",
  "author": "Victor Bandeira",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.duelracer.game",
    "productName": "Duel Racer",
    "files": [
      "main.cjs",
      "preload.cjs",
      "app/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "DuelRacer-${version}-Windows-pasta.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Duel Racer",
      "artifactName": "DuelRacer-${version}-Instalador.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png",
      "category": "public.app-category.racing-games"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    },
    "publish": null,
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "compression": "maximum"
  }
}
