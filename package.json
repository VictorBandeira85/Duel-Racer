{
  "name": "duel-racer",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc",
    "build:single": "tsc && vite build --mode single",
    "artifact": "npm run build:single && node tools/to-artifact.mjs"
  },
  "devDependencies": {
    "potrace": "^2.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/press-start-2p": "^5.1.0"
  }
}
